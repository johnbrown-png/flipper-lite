# Flipper - Git Ignore
# Policy: track all code and docs; exclude bulky generated data, secrets and state.
# The deployed Streamlit app (flipper_lite.py) only needs the files it reads at
# fixed paths - see AGENTS.md "Do not move" list.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
ENV/
env/

# Environment variables / secrets
.env
.streamlit/secrets.toml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Bulky generated data (local only)
data/
captions_output/
Topic_Downloads/
_deletion_backups/
_deletion_logs/
videos_to_delete/
images/
*.pdf

# Archive: keep code and docs, drop bulky data copies
_archive/**/*.csv
_archive/**/*.json

# Curriculum source PDFs (White Rose SOL PDFs, ~1 GB)
Curriculum/source_pdfs/

# State, logs and temporary files
extraction_state.json
relevance_assessment_state.json
search_history.json
qa/logs/
*.log
*.tmp

# Large CSVs not needed for deployment
video_inventory.csv
video_inventory_relevance_scores.csv
audit_results.csv
curriculum_quality_audit.csv
curriculum_quality_audit.summary.txt
